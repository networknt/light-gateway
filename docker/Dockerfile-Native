# Prebuilt-input Dockerfile. From a clean checkout use scripts/build-native-container.sh;
# see README "Native container build" for the source-only prerequisite cache contract.
FROM ghcr.io/graalvm/native-image-community:25 AS builder
WORKDIR /build
COPY target/light-gateway.jar target/light-gateway.jar
COPY docker/native-image.args native-image.args
RUN mkdir native && native-image @native-image.args -o native/server \
    -cp target/light-gateway.jar com.networknt.server.Server

FROM alpine:latest
RUN apk add --no-cache gcompat curl zlib
WORKDIR /app
# Include the executable and any native-image companion libraries (e.g. management support).
COPY --from=builder /build/native/ /app/
RUN mkdir /config
ENTRYPOINT ["/app/server", "-Dlight-4j-config-dir=/config", "-Dlogback.configurationFile=/config/logback.xml"]
